# The public DNS name pointed at this server. Do not include https:// or a path.
DOMAIN=app.example.com
CERTBOT_EMAIL=admin@example.com

# Set to 1 while testing to avoid Let's Encrypt production rate limits.
CERTBOT_STAGING=0

DB_NAME=educore
DB_USER=educore
DB_ROOT_PASSWORD=replace-with-a-strong-root-password
DB_PASSWORD=replace-with-a-strong-database-password
