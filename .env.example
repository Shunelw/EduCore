# Used only by docker-compose.yml to configure the MariaDB container and
# to build the backend's DATABASE_URL inside Docker.
# These values must match DB_NAME / DB_USER / DB_PASSWORD in backend/.env.
DB_NAME=educore
DB_USER=educore
DB_ROOT_PASSWORD=changeme
DB_PASSWORD=changeme

# Public, browser-reachable URLs. For a VPS deployment, replace these with
# your HTTPS domains (for example, https://app.example.com and
# https://api.example.com). AZURE_REDIRECT_URI must exactly match the redirect
# URI registered for the application in Microsoft Entra ID.
FRONTEND_URL=http://localhost:8080
VITE_API_URL=http://localhost:3000
AZURE_REDIRECT_URI=http://localhost:3000/api/auth/callback
